model DatasetPublishingStatus {
    id String @id @default(cuid(2))

    datasetId String  @unique
    dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

    status Int @default(0) // -1: failed, 0: not started, ...

    comment           String @default("")
    currentFileNumber Int    @default(0)
    fileCount         Int    @default(0)

    updated DateTime @updatedAt
    created DateTime @default(now())
}

// Background work picked up by scripts/process-task-queue.ts
model Task {
    id String @id @default(cuid(2))

    type   String // publish-dataset | rebuild-frozen-data | purge-draft
    status String @default("pending") // pending | running | completed | failed

    datasetId String
    dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

    payload Json @default("{}") // Task-specific input, written when the task is queued

    runAfter DateTime @default(now()) // The task is not picked up before this time
    attempts Int      @default(0)
    error    String   @default("") // Last failure message

    startedAt   DateTime?
    heartbeatAt DateTime? // Refreshed while running. A stale one means the runner stopped mid-task
    completedAt DateTime?

    updated DateTime @updatedAt
    created DateTime @default(now())

    @@index([status, runAfter])
}

model PublishedDataset {
    id Int @id @default(autoincrement())

    // This field isn't attached because it can be deleted from the source side.
    // TODO: datasetId might need to be unique
    datasetId   String?
    canonicalId String?

    doi String?

    title       String
    description String

    versionTitle String
    studyTitle   String

    public Boolean @default(false) // Access level picked when publishing. false = controlled, so each request needs owner approval

    // Keep track of the status of the publishing process (used to show the progress bar or badge on the portal)
    status      String  @default("") // "moving-dataset-to-published-storage" | "ready"
    containerId String? @unique

    publishedMetadata Json
    files             Json
    data              Json

    automated   Boolean @default(false) // Whether the dataset was published through an automated process (e.g. zenodo sync) or manually by a user through the portal
    external    Boolean @default(false)
    externalUrl String?

    updated DateTime @updatedAt
    created DateTime @default(now())

    DatasetRequest DatasetRequest[]

    PublishedDatasetRegistrationDetails PublishedDatasetRegistrationDetails?
    PublishedDatasetModality            PublishedDatasetModality[]
}

model PublishedDatasetModality {
    id String @id @default(cuid(2))

    publishedDatasetId Int
    publishedDataset   PublishedDataset @relation(fields: [publishedDatasetId], references: [id], onDelete: Cascade)

    modality String // e.g. "oct", "fundus_photography"
    label    String

    fileCount         Int? // null = unknown
    fileCountComplete Boolean  @default(true)
    fileExtensions    String[] @default([])
    detectionMethod   String

    updated DateTime @updatedAt
    created DateTime @default(now())

    @@unique([publishedDatasetId, modality])
    @@index([modality])
}

model PublishedDatasetRegistrationDetails {
    // A table to store where we registered the dataset from. Mainly used for external datasets.
    id String @id @default(cuid(2))

    publishedDatasetId Int              @unique
    publishedDataset   PublishedDataset @relation(fields: [publishedDatasetId], references: [id], onDelete: Cascade)

    datasetSource     String // "zenodo" | "pubmed" | ...
    extractionMethod  String // "manual" | "ep-extraction-script" | ...
    extractionVersion String? // "1.0.0" | 

    requiresAccessRequest Boolean?
    accessRequestUrl      String?
    accessConditions      String?
    embargoUntil          DateTime?

    updated DateTime @updatedAt
    created DateTime @default(now())
}

model ControlledDatasetRequest {
    id String @id @default(cuid(2))

    datasetId String
    dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

    updated DateTime @updatedAt
    created DateTime @default(now())

    DatasetRequest DatasetRequest?

    User   User?   @relation(fields: [userId], references: [id])
    userId String?
}

model DatasetRequest {
    id String @id @default(cuid(2))

    // This is used to link the request to the controlled dataset request if the dataset is controlled
    isControlledDatasetRequest Boolean                   @default(false)
    controlledDatasetRequestId String?                   @unique
    controlledDatasetRequest   ControlledDatasetRequest? @relation(fields: [controlledDatasetRequestId], references: [id], onDelete: Cascade)

    givenName    String
    familyName   String
    emailAddress String
    affiliation  String

    reasonForAccess String

    status  String @default("pending")
    comment String @default("")

    created DateTime @default(now())
    updated DateTime @updatedAt

    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    DatasetRequestDetails DatasetRequestDetails[]

    Dataset   Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
    datasetId String?

    PublishedDataset   PublishedDataset @relation(fields: [publishedDatasetId], references: [id], onDelete: Cascade)
    publishedDatasetId Int
}

model DatasetRequestDetails {
    id String @id @default(cuid(2))

    datasetRequestId String
    datasetRequest   DatasetRequest @relation(fields: [datasetRequestId], references: [id], onDelete: Cascade)

    unsignedDataUseAgreement        String? // link to unsigned data use agreement
    requesterSignedDataUseAgreement String? // link to requester signed data use agreement
    submitterSignedDataUseAgreement String? // link to submitter signed data use agreement
    signedDataUseAgreement          String? // link to signed data use agreement

    status String @default("pending") // pending | approved | rejected | expired

    invalidatedOn DateTime? // when the data owner wants to invalidate the request
    expiresAt     DateTime?

    created DateTime @default(now())
    updated DateTime @updatedAt
}

model ContactMessage {
    id String @id @default(cuid(2))

    name      String
    email     String
    subject   String
    message   String
    status    String  @default("unread") // unread | read | replied
    ipAddress String?
    userAgent String?

    created DateTime @default(now())
    updated DateTime @updatedAt
}
