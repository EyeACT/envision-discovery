  "metadata": {
    "title": "QuPath Segmentation masks of NeuroPAL Images",
    "doi": "10.5281/zenodo.14873352",
    "publication_date": "2025-02-14",
    "description": "<p><a href=\"https://qupath.github.io/\">QuPath</a> segmentation masks of 31 C. Elegans NeuroPAL volumes (20 heads, 11 tails) originally published <a href=\"https://zenodo.org/records/4516655\">here</a>. Please note that the segmentation files do not contain names; you can assign them names by crossreferencing the segmentation centroids with the positions in the neuron ID .mat file.</p>\n<table>\n<tbody>\n<tr>\n<td><strong>Pattern</strong></td>\n<td><strong>Description</strong></td>\n<td><strong>Contents</strong></td>\n</tr>\n<tr>\n<td>&lt;name&gt;<strong>.nd2</strong></td>\n<td>Original colorstack nd2 file.</td>\n<td>Raw acquisition, nikon metadata.</td>\n</tr>\n<tr>\n<td>&lt;name&gt;<strong>.mat</strong></td>\n<td><a href=\"https://zenodo.org/records/13906028\">NeuroPAL_ID</a> colorstack file.</td>\n<td>Processed acquisition, NeuroPAL_ID settings.</td>\n</tr>\n<tr>\n<td>&lt;name&gt;<strong>_ID.mat</strong></td>\n<td><a href=\"https://zenodo.org/records/13906028\">NeuroPAL_ID</a> neuron file.</td>\n<td>Neuron metadata, including positions and names.</td>\n</tr>\n<tr>\n<td>&lt;name&gt;<strong>.qpdata</strong></td>\n<td>QuPath segmentation file.</td>\n<td>Neuron segmentations.</td>\n</tr>\n<tr>\n<td>Zenodo Link (Unsegmented)<strong>.url</strong></td>\n<td>Internet shortcut to original zenodo dataset.</td>\n<td>URL.</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
