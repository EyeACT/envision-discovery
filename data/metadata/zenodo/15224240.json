  "metadata": {
    "title": "A Mycelium Dataset with Edge-Precise Annotation for Semantic Segmentation",
    "doi": "10.5281/zenodo.15224240",
    "publication_date": "2025-10",
    "description": "<p><span lang=\"EN-GB\">This dataset not only offers precise edge segmentation annotations but also establishes a foundational resource for models aimed at enhancing the accuracy of segmentation capabilities related to mycelium edge morphology, thereby serving as a valuable asset in the realms of computer vision and mycology.MyceliumSeg</span><span lang=\"EN-GB\"><span lang=\"EN-US\">&nbsp;is the first publicly available mycelium segmentation dataset with precise edge annotations, filling a critical gap in this research area.</span></span></p>\n<p>&nbsp;</p>",
