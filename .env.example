# ENVISION Discovery environment variables

# OSF personal access token (10,000 req/day vs 100 req/hr)
# Create at: https://osf.io/settings/tokens
OSF_TOKEN=

# Figshare personal access token (higher rate limits)
# Create at: https://figshare.com/account/applications
FIGSHARE_ACCESS_TOKEN=

# Kaggle API token (starts with KGAT_)
# Or set KAGGLE_USERNAME + KAGGLE_KEY
KAGGLE_API_TOKEN=

# Envision Portal API (for add_dataset_records.py)
EXTERNAL_API_KEY=
API_BASE_URL=http://localhost:3000
